#!/usr/bin/env sh
# Husky pre-commit hook:
#   1. Auto-fix Python files with ruff (directly, not via lint-staged)
#   2. Re-stage any ruff-fixed changes
#   3. Run lint-staged on client files (biome check on .ts/.tsx/.js/.jsx/.json/.css)
#
# The ruff step is done directly (not through lint-staged) because lint-staged
# runs from the client directory where the `*.py` pattern may not match staged
# Python files reliably. Running ruff directly on the git-staged Python file
# list ensures every Python change is auto-fixed regardless of directory.
#
# lint-staged is still used for client-side files (biome check) because those
# tools live in voice_typer/client/node_modules and lint-staged handles them
# correctly from the client CWD.

# The parent husky wrapper runs this script with `sh -e`, which means ANY
# non-zero exit from a command aborts the script. We handle ruff's exit code
# explicitly so that:
#   - `ruff check --fix` exit 1 (unfixable lint) does NOT block the commit
#     (the user will see the warnings in the ruff output)
#   - `ruff format` exit status is also absorbed
#   - lint-staged always runs (its own exit code will block the commit if
#     biome finds real errors)

# ── Step 1: ruff auto-fix on staged Python files ──────────────────────
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)

if [ -n "$STAGED_PY_FILES" ]; then
    echo "→ ruff check --fix (staged Python files)"
    echo "$STAGED_PY_FILES" | tr '\n' '\0' | xargs -0 ruff check --fix || true

    echo "→ ruff format (staged Python files)"
    echo "$STAGED_PY_FILES" | tr '\n' '\0' | xargs -0 ruff format || true

    # Re-stage any files that ruff modified (--fix / format may have changed them).
    echo "$STAGED_PY_FILES" | tr '\n' '\0' | xargs -0 git add
fi

# ── Step 2: lint-staged for client files ─────────────────────────────
# lint-staged runs biome check --write on .ts/.tsx/.js/.jsx/.json/.css files.
# It lives in voice_typer/client/node_modules.
cd voice_typer/client && npx lint-staged

# ── Step 3: pre-commit hooks (mypy, hotkey-reserved-sync, etc.) ──────
# The .husky/pre-commit script previously ran only ruff (Step 1)
# and lint-staged (Step 2), so 7 of the 9 hooks declared in
# .pre-commit-config.yaml (mypy, trailing-whitespace, end-of-file-fixer,
# check-yaml, check-json, check-merge-conflict, check-added-large-files,
# mixed-line-ending, hotkey-reserved-sync) NEVER ran on commit. This
# optional block wires `pre-commit run` in at the end so contributors who
# have pre-commit installed get the full hook suite, while contributors who
# haven't installed it are silently skipped (the `command -v` guard).
cd ../..
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage commit --files $(git diff --cached --name-only --diff-filter=ACMR | tr '\n' ' ') || {
    echo "[pre-commit] hook failures — see above"
    exit 1
  }
fi
