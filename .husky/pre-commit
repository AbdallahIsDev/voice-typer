#!/usr/bin/env sh
# Husky pre-commit hook (single-framework: pre-commit runs everything
# except lint-staged, which is kept ONLY for the client-side biome
# write-fix step that needs lint-staged's working-directory handling).
#
# Flow:
#   1. lint-staged runs biome check --write on staged
#      .ts/.tsx/.js/.jsx/.json/.css files (and re-stages the fixes).
#   2. `pre-commit run --hook-stage commit --files <staged>` runs:
#      ruff (with --fix only — safe fixes), ruff-format --check,
#      trailing-whitespace, end-of-file-fixer, check-yaml/json,
#      check-merge-conflict, check-added-large-files,
#      mixed-line-ending, the local biome-check + client-typecheck +
#      check-branding + hotkey-reserved-sync hooks, AND the mypy hook
#      if it's been promoted back to the commit stage. mypy currently
#      runs at pre-push (see .pre-commit-config.yaml `stages: [pre-push]`).
#
# Why this shape:
#   - The previous version ALSO ran `ruff check --fix` + `ruff format`
#     directly on staged Python files (Step 1 of the old script). That
#     was a duplicate of the ruff hook in .pre-commit-config.yaml, so
#     Python changes were linted twice per commit. Removed in favor of
#     letting the pre-commit ruff hook own that responsibility — single
#     source of truth for the ruff invocation.
#   - `--unsafe-fixes` was removed from .pre-commit-config.yaml's ruff
#     hook at the same time, so neither path can apply unsafe rewrites.
#   - lint-staged is retained for biome because biome's write-fix needs
#     lint-staged's `cd voice_typer/client` CWD handling; the
#     pre-commit-local `biome-check` hook (in .pre-commit-config.yaml)
#     is a read-only CI-style gate that does NOT write fixes.
#
# Exit-code handling:
#   The parent husky wrapper runs this script with `sh -e`, so any
#   non-zero exit aborts the commit. lint-staged's exit code is
#   propagated as-is (biome errors block the commit). The `pre-commit
#   run` block has its own explicit exit-1 fallback so the failure
#   message is human-readable.

# ── Step 1: lint-staged for client files (biome write-fix) ───────────
# lint-staged runs biome check --write on .ts/.tsx/.js/.jsx/.json/.css
# files. It lives in voice_typer/client/node_modules.
cd voice_typer/client && npx lint-staged

# ── Step 2: pre-commit run for the full hook suite ──────────────────
# Runs every hook declared in .pre-commit-config.yaml against the
# staged file list (ruff, ruff-format, trailing-whitespace,
# end-of-file-fixer, check-yaml/json/merge-conflict/added-large-files,
# mixed-line-ending, local biome-check, client-typecheck, check-branding,
# hotkey-reserved-sync). Silently skipped if the contributor has not
# installed pre-commit — keeps the hook usable without forcing a
# pre-commit install for contributors who only touch client code.
cd ../..
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage commit --files $(git diff --cached --name-only --diff-filter=ACMR | tr '\n' ' ') || {
    echo "[pre-commit] hook failures — see above"
    exit 1
  }
fi
