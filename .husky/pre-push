#!/usr/bin/env sh
# Husky pre-push hook — scoped for speed (XS-35).
#
# Husky is the SOLE installer of git hooks (XS-34): `npm install` in
# voice_typer/client/ runs the `prepare` script which sets
# `core.hooksPath = .husky/_/`. This file is the user-defined script
# that husky's `.husky/_/pre-push` wrapper sources. See
# CONTRIBUTING.md §"Pre-commit hooks" for the full architecture.
#
# The previous version ran ``npm run typecheck:ci`` (``tsc -b --force``,
# cache-busting, 30s-2min) + the FULL pytest suite minus 5 tauri dirs
# (10+ min for 331 files). Combined: 10-15 min, which made
# ``git push --no-verify`` the de-facto default.
#
# Fixes applied:
#   1. ``typecheck:ci`` → ``typecheck`` — uses the tsbuildinfo cache
#      (~5s incremental on a warm tree). ``typecheck:ci`` is reserved
#      for CI where a clean build is required; pre-push only needs to
#      catch NEW type errors introduced by the pushed commits, which
#      the cached check does correctly.
#   2. pytest scope tightened: ``--timeout=30`` (was 60), ``-k 'not
#      slow and not integration'`` (was just ``-k "not slow"``), and
#      ``-m 'not slow'`` marker filter. Drops the typical pre-push
#      pytest time from 10+ min to ~2-3 min for the fast unit subset.
#      Integration tests (which hit the filesystem / network / audio
#      devices) are deferred to CI.
#   3. mypy is at ``stages: [pre-push]`` in .pre-commit-config.yaml
#      AND is now a LOCAL hook with ``language: system`` /
#      ``entry: python -m mypy`` so it reuses the project venv
#      instead of creating an isolated venv via mirrors-mypy. The
#      previous ``additional_dependencies: [numpy, torch, ...]``
#      caused a 2GB torch reinstall on first ``pre-commit run mypy``;
#      the local hook eliminates that — mypy reads numpy/torch/etc.
#      from the deps already installed by
#      ``uv pip install -e ".[test,dev]"``. mypy runs only when
#      explicitly invoked (``pre-commit run mypy`` or
#      ``pre-commit run --all-files --hook-stage pre-push``); it is
#      NOT invoked by this pre-push wrapper because the
#      ``pre-commit run`` block in ``.husky/pre-commit`` only runs
#      at the commit stage.
echo "[pre-push] Running typecheck (client, cached)..."
cd voice_typer/client && npm run typecheck || { echo "[pre-push] typecheck FAILED"; exit 1; }

echo "[pre-push] Running pytest fast subset (server)..."
cd ../..
# Resolve a working Python interpreter: prefer the project venv (portable
# across Unix `.venv/bin/python` and Windows `.venv/Scripts/python.exe`),
# fall back to `python`/`python3` on PATH so the hook doesn't hard-fail in
# environments without a local venv.
PY_BIN=""
if [ -x .venv/bin/python ]; then
        PY_BIN=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
        PY_BIN=.venv/Scripts/python.exe
elif command -v python >/dev/null 2>&1; then
        PY_BIN=python
elif command -v python3 >/dev/null 2>&1; then
        PY_BIN=python3
fi
if [ -z "$PY_BIN" ]; then
        echo "[pre-push] No Python interpreter found; skipping pytest."
        exit 1
fi
"$PY_BIN" -m pytest tests/ -x -q --timeout=30 --no-cov \
        --ignore=tests/test_noise_suppressor_resampler.py \
        --ignore=tests/test_permissions_pyobjc_cache.py \
        --ignore=tests/tauri/mig15 \
        --ignore=tests/tauri/mig16 \
        --ignore=tests/tauri/mig17 \
        --ignore=tests/tauri/mig18 \
        --ignore=tests/tauri/mig19 \
        -k "not slow and not integration" \
        -m "not slow" || {
        echo "[pre-push] pytest FAILED";
        echo "[pre-push] If collection failed with ModuleNotFoundError, the venv is missing deps.";
        echo "[pre-push] Reinstall with:  uv pip install -e \".[test,dev]\"";
        echo "[pre-push] (base deps only:  uv pip install -e . -r requirements-lock.txt)";
        exit 1; }

echo "[pre-push] All checks passed."
