#!/usr/bin/env sh
# Husky pre-push hook — lean: seconds-cost gates only.
#
# Husky is the SOLE installer of git hooks (XS-34): `npm install` in
# voice_typer/client/ runs the `prepare` script which sets
# `core.hooksPath = .husky/_/`. This file is the user-defined script
# that husky's `.husky/_/pre-push` wrapper sources. See
# CONTRIBUTING.md §"Pre-commit hooks" for the full architecture.
#
# History: the hook originally ran ``npm run typecheck:ci`` + the FULL
# pytest suite (10-15 min), then was scoped down to a fast pytest subset
# (XS-35, ~2-3 min), which still made ``git push --no-verify`` the
# de-facto default for anyone who greened the suite during work.
#
# The pytest block was REMOVED: the working convention (AGENTS.md) is
# that the full test suite is run and greened at the END of every task
# by the developer/agent doing the work — a push-time pytest re-run
# only re-checks an already-verified test state. Push-time verification
# keeps ONLY the gates that are seconds, not minutes:
#   1. ``npm run typecheck`` — cached client typecheck (~5s incremental
#      on a warm tree; NOT the cache-busting ``typecheck:ci``, which is
#      reserved for CI where a clean build is required).
#   2. mypy ratchet via ``pre-commit run --hook-stage pre-push`` — mypy
#      has NO CI gate, so this hook is its only automated enforcement.
#      Locally: ``stages: [pre-push]`` in .pre-commit-config.yaml,
#      ``language: system`` / ``entry: python scripts/mypy_ratchet_check.py``
#      so it reuses the project venv (no torch reinstall, XS-35) and
#      blocks only NEW typing errors vs mypy-baseline.json.
echo "[pre-push] Running typecheck (client, cached)..."
cd voice_typer/client && npm run typecheck || { echo "[pre-push] typecheck FAILED"; exit 1; }
cd ../..

# Run pre-commit hooks declared at the `pre-push` stage — mypy only
# (see .pre-commit-config.yaml `stages: [pre-push]`). pre-commit is
# optional: skip silently if not installed so the hook still works in
# minimal checkouts. The `--from-ref HEAD~1 --to-ref HEAD` pair scopes
# mypy to files changed in the last commit (matching the pre-commit
# default for push hooks).
echo "[pre-push] Running pre-commit (mypy) at pre-push stage..."
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage pre-push --from-ref HEAD~1 --to-ref HEAD || { echo "[pre-push] pre-commit (mypy) FAILED"; exit 1; }
fi

echo "[pre-push] All checks passed."
