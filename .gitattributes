# Repo-wide LF policy: all tracked text files are LF in the index (blobs
# are LF) and must be LF on every platform regardless of core.autocrlf.
# core.autocrlf=true alone makes git check out CRLF on Windows, so any
# tool that writes LF into an edited region (agents' edit tools, ruff
# format) leaves the file with MIXED line endings — which the
# mixed-line-ending pre-commit hook (`--fix=lf`) then flags for every
# touched file. `eol=lf` keeps the whole checkout LF so edits never mix.
# This is the same convention the specific patterns below already pin.
* text=auto eol=lf

# pyrefly-baseline.json is generated by `pyrefly check --update-baseline`
# and must always use LF line endings regardless of the host OS. The baseline file
# is a program-generated JSON manifest; CRLF would break its deterministic format
# and cause spurious diffs when regenerated on different platforms.
pyrefly-baseline.json text eol=lf

# Linux installer resources are byte-compared against their canonical
# sources by tests (test_linux_installer_paths / test_install_permissions_polkit_stable
# assert bundled == scripts/linux/<file>). They must stay LF on every
# platform regardless of core.autocrlf so the byte equality holds.
src-tauri/resources/linux-scripts/* text eol=lf
scripts/linux/* text eol=lf

# macOS + Windows installer scripts also run at install / uninstall time
# (macOS install.sh / uninstall.sh; Windows uninstall.bat /
# uninstaller.nsh / sign-authenticode.ps1 / uninstall_permissions.py).
# CRLF would break the POSIX shell scripts, and
# tests/test_script_resources_lf.py byte-compares the working tree
# against the committed LF blob + asserts `git check-attr` resolves
# text + eol=lf — so these must stay LF on every platform regardless of
# core.autocrlf.
scripts/macos/* text eol=lf
scripts/windows/* text eol=lf
