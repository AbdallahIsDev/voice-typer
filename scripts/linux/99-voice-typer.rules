# Voice Typer — keyboard event device access
#
# Grants read access to keyboard event devices for members of the "input"
# group. Installed by the Voice Typer package (or via pkexec for AppImage
# users). Do not edit — remove this file to revoke access.
#
# Why MODE="0660" + GROUP="input": owner (root) gets rw, group (input)
# gets rw, others get nothing. This is the standard pattern for /dev/input
# access (same as the docker group for /var/run/docker.sock).
#
# Why udevadm trigger on add: when a USB keyboard is plugged in, the new
# /dev/input/eventN device is created. The rule applies automatically,
# but udevadm trigger ensures the permission change takes effect
# immediately without needing udevadm control --reload.

# Match all input event devices (keyboards, mice, etc.)
KERNEL=="event[0-9]*", SUBSYSTEM=="input", GROUP="input", MODE="0660"

# Reload rule on add (handles hotplugged keyboards)
ACTION=="add", SUBSYSTEM=="input", RUN+="/usr/bin/udevadm trigger --subsystem-match=input"
