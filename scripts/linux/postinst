#!/bin/bash
# Voice Typer — Debian postinst script
#
# Runs as root during `apt install voice-typer`. Performs the zero-command
# Linux keyboard permission setup:
#   1. Installs the udev rule (grants input group read access to /dev/input/event*)
#   2. Adds the installing user to the input group
#   3. Configures Caps Lock neutralization (X11 / GNOME / KDE / Sway)
#   4. Writes a manifest at /var/lib/voice-typer/permissions-manifest.json
#   5. Installs a polkit-stable symlink so the polkit policy keeps resolving
#      to a working script across Tauri v2 / AppImage installs.
#
# The user only types their sudo password once (prompted by apt itself).
# After install, the user must log out and log back in for the input group
# change to take effect (Linux kernel limitation).

set -e

# The polkit-stable path: the polkit policy hard-codes this path because
# polkit requires an absolute, stable path that does not change across
# AppImage versions or .deb / .rpm upgrades. The Tauri v2 bundle physically
# installs the script at /usr/lib/voice-typer/resources/linux-scripts/, so
# this postinst installs a symlink at the polkit-stable path pointing at the
# actually-installed script.
POLKIT_STABLE_PATH="/usr/share/voice-typer/scripts/install_permissions.py"

case "$1" in
    configure)
        # Find the install_permissions.py script.
        # Probe ALL 5 canonical candidate paths so the script is found
        # regardless of which installer produced the package (Tauri v2
        # .deb, legacy Electron .deb, AppImage, manual install).
        # The probe order is: polkit-stable path first (so re-installs
        # short-circuit), then Tauri v2 resource paths, then legacy paths.
        INSTALL_SCRIPT=""
        for candidate in \
            "/usr/share/voice-typer/scripts/install_permissions.py" \
            "/usr/lib/voice-typer/scripts/install_permissions.py" \
            "/usr/lib/voice-typer/resources/scripts/install_permissions.py" \
            "/usr/lib/voice-typer/resources/scripts/linux/install_permissions.py" \
            "/usr/lib/voice-typer/resources/linux-scripts/install_permissions.py"; do
            if [ -f "$candidate" ]; then
                INSTALL_SCRIPT="$candidate"
                break
            fi
        done
        if [ -z "$INSTALL_SCRIPT" ]; then
            echo "[voice-typer] WARNING: install_permissions.py not found — skipping keyboard permission setup"
            echo "[voice-typer] The hotkey may not work. Install the package via apt to get the setup script."
            exit 0
        fi

        echo "[voice-typer] Setting up keyboard permissions (using $INSTALL_SCRIPT)..."
        python3 "$INSTALL_SCRIPT" || {
            echo "[voice-typer] WARNING: keyboard permission setup failed (non-fatal)"
            echo "[voice-typer] The hotkey may not work until permissions are granted."
        }

        # Install the polkit-stable symlink so the polkit policy resolves
        # to the actually-installed script. Skip if INSTALL_SCRIPT already
        # equals POLKIT_STABLE_PATH (avoids clobbering an existing regular
        # file at the polkit-stable path — e.g. legacy Electron installs
        # that physically place the script there).
        if [ "$INSTALL_SCRIPT" != "$POLKIT_STABLE_PATH" ]; then
            mkdir -p "$(dirname "$POLKIT_STABLE_PATH")"
            ln -sfn "$INSTALL_SCRIPT" "$POLKIT_STABLE_PATH"
            echo "[voice-typer] Installed polkit-stable symlink: $POLKIT_STABLE_PATH -> $INSTALL_SCRIPT"
        fi

        echo ""
        echo "Voice Typer setup complete."
        echo "IMPORTANT: You must log out and log back in for the 'input' group"
        echo "change to take effect. After that, Voice Typer will work automatically."
        echo ""
    ;;
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

# Trigger desktop database update if we installed any .desktop files
if [ -x /usr/bin/update-desktop-database ]; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi

exit 0
