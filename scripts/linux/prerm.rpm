#!/bin/bash
# Voice Typer — RPM %preun script
#
# Runs as root during `dnf remove voice-typer`. Removes the udev rule and
# XKB config. Does NOT remove the user from the input group (other apps
# may rely on it — see uninstall_permissions.py).
#
# Also removes the per-user autostart .desktop entry
# (~/.config/autostart/voice-typer.desktop) so the launcher does not
# respawn the app on next login after uninstall.
#
# Also removes the per-user prewarm systemd user units
# (~/.config/systemd/user/voice-typer-prewarm.{timer,service}) — mirrors
# the Debian prerm's remove_prewarm_for_home() cleanup so RPM uninstalls
# don't leave a stale systemd timer pointing at the now-deleted frozen
# prewarm binary (which would log failed-unit journal spam on every
# login).
#
# Functionally identical to the Debian prerm — probes the same 5 canonical
# candidate paths so the uninstall script is found regardless of which
# installer produced the package (Tauri v2 .rpm, legacy Electron .rpm,
# AppImage, manual install).

set -e

# $1 = 0 means uninstall (not upgrade). $1 = 1 means upgrade (keep autostart).
if [ "$1" = "0" ]; then
    # Probe ALL 5 canonical candidate paths so the uninstall script is
    # found regardless of which installer produced the package.
    UNINSTALL_SCRIPT=""
    for candidate in \
        "/usr/share/voice-typer/scripts/uninstall_permissions.py" \
        "/usr/lib/voice-typer/scripts/uninstall_permissions.py" \
        "/usr/lib/voice-typer/resources/scripts/uninstall_permissions.py" \
        "/usr/lib/voice-typer/resources/scripts/linux/uninstall_permissions.py" \
        "/usr/lib/voice-typer/resources/linux-scripts/uninstall_permissions.py"; do
        if [ -f "$candidate" ]; then
            UNINSTALL_SCRIPT="$candidate"
            break
        fi
    done
    if [ -n "$UNINSTALL_SCRIPT" ]; then
        echo "[voice-typer] Removing keyboard permissions (using $UNINSTALL_SCRIPT)..."
        python3 "$UNINSTALL_SCRIPT" || true
    else
        echo "[voice-typer] uninstall_permissions.py not found — skipping keyboard-permission cleanup"
    fi

    # Terminate any running voice-typer processes BEFORE removing the
    # autostart .desktop / prewarm systemd unit files. If the app is
    # still running during file removal, it may re-create the files
    # (the prewarm scheduler periodically re-arms its systemd timer)
    # which would leave a stale launcher pointing at the now-deleted
    # binary on next login. We:
    #   1. Read each user's backend PID lockfile
    #      (~/.local/share/voice-typer/backend.pid — written by
    #      single_instance.py) and send a targeted SIGTERM so the
    #      app can run its shutdown teardown (flush history DB,
    #      release the audio device, clear the PID file).
    #   2. pkill -TERM -x voice-typer-tauri — catches the Tauri
    #      host binary even if the backend PID file is missing
    #      (e.g. crashed hard and never wrote it).
    #   3. pkill -TERM -f 'python-sidecar' — catches the frozen
    #      Python sidecar binary by command-line substring match.
    #   4. sleep 1 — gives the SIGTERM'd processes time to actually
    #      exit and release file handles before we rm their unit
    #      files. 1s is enough on every desktop we've tested; the
    #      teardown is well under 200ms (see shutdown_controller.py).
    terminate_voice_typer_processes() {
        while IFS=: read -r _ _ uid _ _ home_dir _; do
            [ -n "$home_dir" ] || continue
            [ "$uid" -ge 1000 ] 2>/dev/null || continue
            local pid_file="$home_dir/.local/share/voice-typer/backend.pid"
            if [ -f "$pid_file" ]; then
                local pid
                pid="$(cat "$pid_file" 2>/dev/null | tr -d '[:space:]' || true)"
                if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                    kill -TERM "$pid" 2>/dev/null || true
                fi
            fi
        done < <(getent passwd 2>/dev/null || true)
        # /root may also have a backend.pid (rare, but possible if the
        # user ever ran voice-typer via sudo -E).
        local root_pid_file="/root/.local/share/voice-typer/backend.pid"
        if [ -f "$root_pid_file" ]; then
            local root_pid
            root_pid="$(cat "$root_pid_file" 2>/dev/null | tr -d '[:space:]' || true)"
            if [ -n "$root_pid" ] && kill -0 "$root_pid" 2>/dev/null; then
                kill -TERM "$root_pid" 2>/dev/null || true
            fi
        fi
        # Catch-all for any voice-typer-tauri / python-sidecar processes
        # that the targeted PID lookup missed (stale lockfile, hard
        # crash, manually-launched dev instance, etc.).
        pkill -TERM -x voice-typer-tauri 2>/dev/null || true
        pkill -TERM -f 'python-sidecar' 2>/dev/null || true
        sleep 1
    }

    terminate_voice_typer_processes

    # Remove the per-user autostart .desktop entry for every non-system
    # user. The .desktop file is created by autostart_launcher.py and
    # would otherwise respawn Voice Typer on next login after uninstall.
    remove_autostart_for_home() {
        local home_dir="$1"
        [ -d "$home_dir" ] || return 0
        local autostart_dir="$home_dir/.config/autostart"
        if [ -d "$autostart_dir" ]; then
            find "$autostart_dir" -maxdepth 1 -name "voice-typer.desktop" -delete 2>/dev/null || true
        fi
    }

    # Prewarm systemd user-unit cleanup — mirrors the Debian prerm's
    # remove_prewarm_for_home() exactly. The prewarm scheduler
    # (voice_typer/server/prewarm_scheduler_posix.py) registers a
    # SEPARATE systemd user timer + service at
    # ~/.config/systemd/user/voice-typer-prewarm.{timer,service} with
    # unit names `voice-typer-prewarm.timer` / `voice-typer-prewarm.service`.
    # These are distinct from the autostart .desktop entry above. Without
    # this cleanup, systemd --user keeps trying to launch the (now-deleted)
    # frozen prewarm binary at every login → journal spam + failed-unit
    # errors. We disable --now (best-effort, root speaking for the user via
    # --machine=...) and then delete the unit files.
    remove_prewarm_for_home() {
        local home_dir="$1"
        [ -d "$home_dir" ] || return 0
        local unit_dir="$home_dir/.config/systemd/user"
        [ -d "$unit_dir" ] || return 0
        local user_name
        user_name="$(basename "$home_dir")"
        # Disable + stop the timer + service (best-effort). prerm.rpm runs
        # as root; `systemctl --user --machine=<user>@.host` lets root act
        # on the user's user-session manager. Non-fatal if the user has
        # no active systemd user session or systemd is unavailable.
        if [ -n "$user_name" ] && [ "$user_name" != "root" ]; then
            systemctl --user --machine="${user_name}@.host" disable --now \
                voice-typer-prewarm.timer voice-typer-prewarm.service 2>/dev/null || true
        fi
        rm -f "$unit_dir/voice-typer-prewarm.service" \
              "$unit_dir/voice-typer-prewarm.timer"
    }

    while IFS=: read -r _ _ uid _ _ home_dir _; do
        [ -n "$home_dir" ] || continue
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        remove_autostart_for_home "$home_dir"
        remove_prewarm_for_home "$home_dir"
    done < <(getent passwd 2>/dev/null || true)
    remove_autostart_for_home /root
    remove_prewarm_for_home /root

    # Refresh the desktop database + icon cache so the launcher
    # entry + hicolor icon disappear from application menus
    # immediately after removal (mirrors the Debian prerm).
    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
fi

exit 0
