#!/bin/bash
# Voice Typer — RPM %preun script
#
# Runs as root during `dnf remove voice-typer`. Removes the udev rule and
# XKB config.

set -e

if [ "$1" = "0" ]; then
    # $1 = 0 means uninstall (not upgrade)
    UNINSTALL_SCRIPT="/usr/share/voice-typer/scripts/uninstall_permissions.py"
    if [ -f "$UNINSTALL_SCRIPT" ]; then
        echo "[voice-typer] Removing keyboard permissions..."
        python3 "$UNINSTALL_SCRIPT" || true
    fi
fi

exit 0
