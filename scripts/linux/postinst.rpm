#!/bin/bash
# Voice Typer — RPM %post script
#
# Functionally identical to the Debian postinst. Runs as root during
# `dnf install voice-typer`. Probes the same 5 canonical candidate paths
# so the script is found regardless of which installer produced the
# package (Tauri v2 .rpm, legacy Electron .rpm, AppImage, manual install).
# Also installs the polkit-stable symlink so the polkit policy keeps
# resolving to a working script across Tauri v2 / AppImage installs.
#
# RPM convention: $1 = 1 means first install, $1 = 2 means upgrade.
# The body is gated on `$1 -eq 1` so the keyboard-permission setup +
# polkit symlink + desktop/icon cache refresh only run on first install
# (NOT on upgrade — the previous install's permissions + symlink are
# already correct and re-running install_permissions.py would prompt
# the user unnecessarily). This mirrors the prerm.rpm's
# `if [ "$1" = "0" ]` uninstall-gate pattern.

set -e

# $1 = 1 means first install. $1 = 2 means upgrade (skip — already set up).
if [ "$1" -eq 1 ]; then
    # The polkit-stable path: the polkit policy hard-codes this path because
    # polkit requires an absolute, stable path that does not change across
    # AppImage versions or .rpm upgrades. The Tauri v2 bundle physically
    # installs the script at /usr/lib/voice-typer/resources/linux-scripts/,
    # so this %post installs a symlink at the polkit-stable path pointing at
    # the actually-installed script.
    POLKIT_STABLE_PATH="/usr/share/voice-typer/scripts/install_permissions.py"

    # Find the install_permissions.py script.
    # Probe ALL 5 canonical candidate paths so the script is found regardless
    # of which installer produced the package.
    INSTALL_SCRIPT=""
    for candidate in \
        "/usr/share/voice-typer/scripts/install_permissions.py" \
        "/usr/lib/voice-typer/scripts/install_permissions.py" \
        "/usr/lib/voice-typer/resources/scripts/install_permissions.py" \
        "/usr/lib/voice-typer/resources/scripts/linux/install_permissions.py" \
        "/usr/lib/voice-typer/resources/linux-scripts/install_permissions.py"; do
        if [ -f "$candidate" ]; then
            INSTALL_SCRIPT="$candidate"
            break
        fi
    done

    if [ -z "$INSTALL_SCRIPT" ]; then
        echo "[voice-typer] WARNING: install_permissions.py not found — skipping keyboard permission setup"
        echo "[voice-typer] The hotkey may not work. Install the package via dnf to get the setup script."
        exit 0
    fi

    echo "[voice-typer] Setting up keyboard permissions (using $INSTALL_SCRIPT)..."
    python3 "$INSTALL_SCRIPT" || {
        echo "[voice-typer] WARNING: keyboard permission setup failed (non-fatal)"
        echo "[voice-typer] The hotkey may not work until permissions are granted."
    }

    # Install the polkit-stable symlink so the polkit policy resolves to the
    # actually-installed script. Skip if INSTALL_SCRIPT already equals
    # POLKIT_STABLE_PATH (avoids clobbering an existing regular file at the
    # polkit-stable path).
    if [ "$INSTALL_SCRIPT" != "$POLKIT_STABLE_PATH" ]; then
        mkdir -p "$(dirname "$POLKIT_STABLE_PATH")"
        ln -sfn "$INSTALL_SCRIPT" "$POLKIT_STABLE_PATH"
        echo "[voice-typer] Installed polkit-stable symlink: $POLKIT_STABLE_PATH -> $INSTALL_SCRIPT"
    fi

    echo ""
    echo "Voice Typer setup complete."
    echo "IMPORTANT: You must log out and log back in for the 'input' group"
    echo "change to take effect."
    echo ""

    # Refresh the desktop database + icon cache so the launcher
    # entry + hicolor icon appear in application menus immediately
    # after install (mirrors the Debian postinst). Non-fatal — if the
    # helpers are missing (minimal container installs), the script
    # still exits 0.
    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
fi

exit 0
