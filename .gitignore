.venv/
.pytest_cache/
.playwright-mcp/
__pycache__/
*.py[cod]
*.egg-info/

# DEAD-003: Electron/Vite build outputs — never commit these.
# They're regenerated on every `npm run build` and bloat the repo.
voice_typer/client/out/
voice_typer/client/src/renderer/dist/
# BUILD-N15: also ignore the root build/ and dist/ dirs used by
# setuptools and PyInstaller.  Note: the leading slash anchors these
# to the repo root so they don't accidentally match subdirectories
# like scripts/build/ (which contains tracked build scripts).
/build/
/dist/
*.tsbuildinfo

# Runtime/debug output
*.log
runtime_log*.txt
voice_typer_stderr.log
PROBLEMS.md
PROMPT.md
REPORT.md
nul

# Local test/debug
_cuda_test.py

# Local editor/OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
artifacts/
audit/
# docs/*
FORENSIC_REVIEW.md
docs/Qwen_integation.md
FORENSIC_REVIEW_2026-06-17.md
rebuild-and-launch.ps1
voice_typer/server/assets/
.opencode/

# BUILD-N15: Python coverage / type-checker caches that should never
# ship in the repo. Without these patterns a single `pytest --cov` or
# `mypy voice_typer` run leaves dozens of cache files in the tree.
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/
.pyrefly_cache/
.tox/
.pytype/

# BUILD-N15: environment files — local secrets / API keys must never
# be committed. The `.env` file is loaded by the test suite only when
# present, but should never appear in `git status`.
.env
.env.*
!.env.example

# Workspace Manager
.workspace/
README.ws.md
bubble.md
archive/deleted_files.txt
SUMMARY-1.md
SUMMARY-3.md
SUMMARY-2.md
SUMMARY-4.md
