.venv/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
node_modules/
.agents/

# Electron/Vite build outputs — never commit these.
# They're regenerated on every `npm run build` and bloat the repo.
# NOTE: `csp-plugin.ts` at the client root is a SOURCE file (tracked,
# imported by electron.vite.config.ts), NOT a build output — do not add
# it here. It is covered by tsconfig.node.json explicitly.
voice_typer/client/out/
voice_typer/client/src/renderer/dist/
# also ignore the root build/ and dist/ dirs used by
# setuptools and PyInstaller.  Note: the leading slash anchors these
# to the repo root so they don't accidentally match subdirectories
# like scripts/build/ (which contains tracked build scripts).
/build/
/dist/
*.tsbuildinfo
# electron-vite cached transpiled config (auto-generated from electron.vite.config.ts)
voice_typer/client/electron.vite.config.*.mjs
# Runtime/debug output
*.log
runtime_log*.txt
voice_typer_stderr.log
PROBLEMS.md
PROMPT.md

# Local clippy toolchain workaround (MSYS2 response-file bug):
# src-tauri/.cargo-tmp holds a linker wrapper + build-script helper
# needed to run `cargo clippy` on this machine. Never commit.
.cargo-tmp/
src-tauri/.cargo-tmp/
REPORT.md
nul
# Local test/debug
_cuda_test.py
# ruff ratchet CI artifact — produced by `ruff check ... --output-format=json`
# and consumed by scripts/ruff_ratchet_check.py. Never commit; regenerate locally
# with the same ruff invocation if you need it.
ruff-current.json
# Local editor/OS files
.idea/
.vscode/
\#components/
.DS_Store
Thumbs.db
artifacts/
audit/
# docs/*
FORENSIC_REVIEW.md
docs/Qwen_integation.md
FORENSIC_REVIEW_2026-06-17.md
rebuild-and-launch.ps1
voice_typer/server/assets/
.opencode/
# Python coverage / type-checker caches that should never
# ship in the repo. Without these patterns a single `pytest --cov` or
# `mypy voice_typer` run leaves dozens of cache files in the tree.
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/
.pyrefly_cache/
.tox/
.pytype/
# environment files — local secrets / API keys must never
# be committed. The `.env` file is loaded by the test suite only when
# present, but should never appear in `git status`.
.env
.env.*
!.env.example
# Tauri / Rust build artifacts — never commit the Cargo build cache.
# src-tauri/target/ is the multi-GB output of `cargo check`/`cargo build`
# (rlibs, rmetas, .rcgu.o, .fingerprint, build/ intermediates). It is
# regenerated on every build and must not enter git.
src-tauri/target/
# Custom --target-dir variants used by verification runs (NOT gitignored by
# the default target/ rule — must be listed explicitly so they never appear
# in `git status`).
src-tauri/target-gnu*/
# Tauri v2 build output (bundles/binaries/resources copied by `tauri build`).
src-tauri/src-tauri/
# NOTE: src-tauri/Cargo.lock IS intentionally committed (Tauri is a binary
# app, not a library — reproducible builds require the lockfile in git).
# Workspace Manager
.workspace/
.freebuff/
# Git worktrees — sibling worktree roots live under .worktree/
.worktree/
README.ws.md
bubble.md
DONE.md
instructions.md
# Verification-only stubs (cargo check on GNU target without MSVC) — do NOT commit
src-tauri/bin/
src-tauri/resources/native/
src-tauri/resources/prewarm-*
src-tauri/.cargo/
# cargo check run logs (any suffix variant: cargo-check-log.txt, -vv, -vv-full)
cargo-check-*.txt
src-tauri/gen/
.sessions/
MERGE_CONTEXT_BRIEF.md
-*
changes/
# Local downloads (not committed)
downloads/
merged-output/
status.md
sub-worklog-*.md
WINDOWS_PIPELINE_LOCAL_RUN_STATUS.md
archive/deleted_files.txt

ruff_base_snap.json
ruff_now_snap.json
