# EditorConfig is awesome: https://editorconfig.org
# BUILD-N09: ensures consistent line endings, indentation, and final
# newlines across editors / IDEs / CI. Without this, developers on
# Windows CRLF machines produce diffs that Linux contributors see as
# "every line changed".

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
