# EditorConfig is awesome: https://editorconfig.org
# NEW-DOC-011: standard editor configuration for consistent formatting
# across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css,html,md,yml,yaml}]
indent_size = 2

[*.{py,pyi}]
# Python: ruff enforces line-length = 120 (see pyproject.toml).
# EditorConfig just sets the default indent; ruff handles wrapping.
indent_size = 4

[Makefile]
indent_style = tab

[*.{svg,xml}]
indent_size = 2

[.gitignore]
indent_size = 2
