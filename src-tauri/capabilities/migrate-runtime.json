{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "migrate-runtime",
  "description": "ADR-0020: least-privilege capability for the Tauri + Python Sidecar migration. Every permission is explicit (Tauri v2 ships zero permissions by default). The shell:allow-spawn permission is scoped to ONLY the python-sidecar binary via the plugins.shell.scope in tauri.conf.json — Tauri v2 enforces both the capability permission AND the config scope at runtime.",
  "windows": ["main", "bubble"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",

    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",

    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",

    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",

    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-menu",
    "core:tray:allow-set-tooltip",
    "core:tray:allow-set-title",
    "core:tray:allow-set-visible",
    "core:tray:allow-get-by-id",
    "core:tray:allow-remove-by-id"
  ]
}
