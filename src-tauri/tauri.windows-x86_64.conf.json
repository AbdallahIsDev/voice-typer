{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Voice Typer",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "visible": true,
        "label": "main"
      },
      {
        "title": "Voice Typer Bubble",
        "width": 240,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "label": "bubble"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "resources": [
      "resources/native/windows-key-listener.exe",
      "resources/prewarm-x86_64-pc-windows-msvc.exe",
      "icons/tray/"
    ]
  }
}
