{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Typer",
  "version": "1.0.0",
  "identifier": "com.voicetyper.app",
  "build": {
    "frontendDist": "../voice_typer/client/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../voice_typer/client && npm run build:renderer",
    "beforeBuildCommand": "cd ../voice_typer/client && npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voice Typer",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": true,
        "label": "main"
      },
      {
        "title": "Voice Typer Bubble",
        "width": 240,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "label": "bubble"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "main-runtime",
        "bubble-runtime"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "bin/python-sidecar"
    ],
    "resources": [
      "resources/native/windows-key-listener.exe",
      "resources/native/macos-key-listener",
      "resources/native/linux-key-listener",
      "resources/prewarm-x86_64-pc-windows-msvc.exe",
      "resources/prewarm-aarch64-pc-windows-msvc.exe",
      "resources/prewarm-x86_64-apple-darwin",
      "resources/prewarm-aarch64-apple-darwin",
      "resources/prewarm-x86_64-unknown-linux-gnu",
      "resources/prewarm-aarch64-unknown-linux-gnu",
      "resources/linux-scripts/install_permissions.py",
      "resources/linux-scripts/uninstall_permissions.py",
      "resources/linux-scripts/99-voice-typer.rules",
      "resources/linux-scripts/00-voice-typer-capslock.conf",
      "resources/linux-scripts/voice-typer.polkit"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libnotify4",
          "libxtst6",
          "libwebkit2gtk-4.1-0",
          "wl-clipboard",
          "xclip"
        ],
        "desktopTemplate": "voice-typer.desktop.template",
        "_comment": "Tauri v2 keys use the 'Script' suffix (postInstallScript / preRemoveScript). v1 used postInstall / preRemove (no suffix). Do NOT rename to the v1 short form — it will break the build.",
        "postInstallScript": "../scripts/linux/postinst",
        "preRemoveScript": "../scripts/linux/prerm"
      },
      "rpm": {
        "depends": [
          "libnotify",
          "libXtst",
          "webkit2gtk3",
          "wl-clipboard",
          "xclip"
        ],
        "_comment": "Tauri v2 keys use the 'Script' suffix (postInstallScript / preRemoveScript). v1 used postInstall / preRemove (no suffix). Do NOT rename to the v1 short form — it will break the build.",
        "postInstallScript": "../scripts/linux/postinst.rpm",
        "preRemoveScript": "../scripts/linux/prerm.rpm"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "notification": {},
    "clipboard-manager": {},
    "single-instance": {},
    "dialog": {},
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "bin/python-sidecar",
          "cmd": "bin/python-sidecar",
          "sidecar": true,
          "args": ["--ws"]
        }
      ]
    }
  }
}
