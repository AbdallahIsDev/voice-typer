+# ─── External corrections loader ─────────────────────────────────────────
+# When a corrections.json exists in the config directory (or at the path
+# specified by config.corrections_path), its entries OVERRIDE the built-in
+# defaults.  This allows users to tailor corrections for their model/version
+# without editing source code.
+
+
+def _load_external_corrections(config_dir: Path | None = None, corrections_path: str | None = None):
+    """Load corrections from an external JSON file.
+
+    Returns (misspellings, phrase_corrections, extra_word_patterns) if the
+    file exists and is valid, otherwise returns None.
+    """
+    path = None
+    if corrections_path:
+        path = Path(corrections_path)
+    elif config_dir is not None:
+        path = config_dir / "voice-typer-corrections.json"
+
+    if path is None or not path.exists():
+        return None
+
+    try:
+        with open(path, encoding="utf-8") as f:
+            data = json.load(f)
+
+        misspellings = data.get("misspellings", {})
+        phrase_corrections = [
+            (entry[0], entry[1]) if isinstance(entry, list) else (entry[0], entry[1])
+            for entry in data.get("phrase_corrections", [])
+        ]
+        extra_word_patterns = [
+            (entry[0], entry[1]) if isinstance(entry, list) else (entry[0], entry[1])
+            for entry in data.get("extra_word_patterns", [])
+        ]
+
+        log.info("[CLEANUP] Loaded external corrections from %s (%d misspellings, "
+                 "%d phrases, %d extra-word patterns)",
+                 path, len(misspellings), len(phrase_corrections), len(extra_word_patterns))
+        return misspellings, phrase_corrections, extra_word_patterns
+    except Exception as e:
+        log.warning("[CLEANUP] Failed to load external corrections from %s: %s", path, e)
+        return None
+
+
+def _active_corrections(config_dir: Path | None = None, corrections_path: str | None = None):
+    """Return the active corrections, preferring external file over built-in."""
+    external = _load_external_corrections(config_dir, corrections_path)
+    if external is not None:
+        return external
+    return _WHISPER_MISSPELLINGS, _WHISPER_PHRASE_CORRECTIONS, _COMMON_EXTRA_WORD_PATTERNS
+
