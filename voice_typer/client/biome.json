{
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.css",
			"!out",
			"!**/dist",
			"!**/data/hotkey_reserved.json"
		]
	},
	"linter": {
		"rules": {
			"recommended": true
		}
	}
}
