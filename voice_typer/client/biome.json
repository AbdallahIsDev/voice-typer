{
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.css",
			"!out",
			"!**/dist",
			"!**/node_modules",
			"!**/data/hotkey_reserved.json",
			"!**/coverage",
			"!vitest-failures.json",
			"!wip-failures.json"
		]
	},
	"linter": {
		"rules": {
			"recommended": true
		}
	}
}
