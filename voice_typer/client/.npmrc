# npm 11+ warns about install scripts not covered by allowScripts.
# These packages have safe install scripts that are required:
#   esbuild — downloads platform binary (postinstall: node install.js)
#   electron-winstaller — selects 7zip arch (install: node ./script/select-7z-arch.js)
# Approved 2026-07-24 to suppress allow-scripts warnings in CI.
esbuild:allowed-install-scripts=postinstall
electron-winstaller:allowed-install-scripts=install
