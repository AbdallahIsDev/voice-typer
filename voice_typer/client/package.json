{
  "name": "voice-typer-desktop",
  "version": "1.0.0",
  "description": "Electron shell for Voice Typer",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "voice-to-text",
    "speech-to-text",
    "asr",
    "whisper",
    "dictation",
    "accessibility",
    "offline",
    "electron",
    "windows"
  ],
  "author": "Abdallah IsDev",
  "imports": {
    "#ui/*": "./src/renderer/src/components/ui/*",
    "#utils": "./src/renderer/src/lib/utils.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:dist:electron": "electron-vite build && electron-builder",
    "start": "electron-vite preview",
    "python:dev": "python3 -m voice_typer.server.ipc_server || python -m voice_typer.server.ipc_server",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/generate-icons.mjs",
    "doctor": "react-doctor",
    "doctor:ci": "react-doctor --scope changed --base main"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "react-doctor": "^0.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html-to-image": "^1.11.13",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
