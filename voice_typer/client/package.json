{
	"name": "voice-typer-desktop",
	"version": "1.0.0",
	"description": "Electron shell for Voice Typer",
	"private": true,
	"main": "./out/main/index.js",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"voice-to-text",
		"speech-to-text",
		"asr",
		"whisper",
		"dictation",
		"accessibility",
		"offline",
		"electron",
		"windows"
	],
	"author": "Abdallah IsDev",
	"imports": {
		"#ui/*": "./src/renderer/src/components/ui/*",
		"#utils": "./src/renderer/src/lib/utils.ts"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"build:renderer": "electron-vite build --config electron.vite.renderer.ts",
		"build:main": "electron-vite build --config electron.vite.main.ts",
		"build:dist:electron": "node scripts/generate-icons.mjs && electron-vite build && electron-builder",
		"start": "electron-vite preview",
		"python:dev": "python3 -m voice_typer.server.ipc_server || python -m voice_typer.server.ipc_server",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"format:check": "biome format src",
		"typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
		"typecheck:root": "tsc -b --noEmit",
		"typecheck:web": "tsc -p tsconfig.web.json --noEmit",
		"typecheck:node": "tsc -p tsconfig.node.json --noEmit",
		"typecheck:ci": "tsc -b --force",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"prebuild": "node scripts/generate-icons.mjs",
		"doctor": "react-doctor",
		"doctor:ci": "react-doctor --scope changed --base main",
		"prepare": "cd ../.. && husky",
		"lint-staged": "lint-staged",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"//devDependencies": "DO NOT DOWNGRADE typescript below 7.x. typescript@7.0.2 is the LATEST STABLE RELEASE (verify: `npm view typescript version`). A prior agent wrongly assumed 7.x was unstable and pinned the lockfile to 5.6.3, which broke `npm ci`. Keep typescript at ^7.0.2 and keep package-lock.json in sync (run `npm install --package-lock-only` after any change).",
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@storybook/addon-themes": "^10.4.6",
		"@storybook/react-vite": "^10.4.6",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"axe-core": "^4.12.1",
		"electron": "^43.0.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "6.0.0-beta.1",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.8",
		"react-doctor": "^0.7.3",
		"shadcn": "^4.13.0",
		"sharp": "^0.35.3",
		"storybook": "^10.4.6",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.2.2",
		"@hugeicons/react": "^1.1.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"html-to-image": "^1.11.13",
		"mdn-data": "^2.29.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.14"
	}
}
